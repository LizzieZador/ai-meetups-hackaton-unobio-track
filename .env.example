# LLM, tried in this order: TEAM_API_KEY (ChatGPT via team gateway) -> GEMINI_API_KEY -> ANTHROPIC_API_KEY
TEAM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# Optional — live read-only AACT Postgres access. If unset, fetch_aact.py falls
# back to local flat-files in data/aact/.
LENS_API_TOKEN=
AACT_DB_HOST=aact-db.ctti-clinicaltrials.org
AACT_DB_PORT=5432
AACT_DB_NAME=aact
AACT_DB_USER=
AACT_DB_PASSWORD=
